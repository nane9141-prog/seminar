{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/seminar/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/seminar/", "destination": "/index.html" },
    { "source": "/seminar/:path*", "destination": "/:path*" }
  ],
  "headers": [
    { "source": "/(.*)\\.(webp|jpg|png|svg|mp4)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
